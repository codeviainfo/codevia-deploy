# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Dominios. Cada uno necesita además su ruta en el túnel de Cloudflare
# (ver README → "Publicar un dominio").
LANDING_DOMAIN=codeviaesp.com
CRM_DOMAIN=crm.codeviaesp.com

# Demos en vivo — deben coincidir con los server_name literales
# en CODEVIA-DEMOS/nginx.conf si los cambias.
DEMO_RESTAURANTE_DOMAIN=demo-restaurante.codeviaesp.com
DEMO_CLINICA_DOMAIN=demo-clinica.codeviaesp.com
DEMO_TIENDA_DOMAIN=demo-tienda.codeviaesp.com
DEMO_ASESORIA_DOMAIN=demo-asesoria.codeviaesp.com

# Portfolio personal — debe coincidir con el server_name literal
# en CODEVIA-PORTFOLIO-HUGO/nginx.conf si lo cambias.
PORTFOLIO_HUGO_DOMAIN=hugo.codeviaesp.com

# ─── CRM — Base de datos ──────────────────────
# Un solo PostgreSQL para todo: el CRM, Córdoba Bets y Breakpoint
# tienen cada uno su propia base dentro de él.
POSTGRES_USER=codevia
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=codevia_crm

# ─── CRM — Backend ────────────────────────────
# JWT_SECRET: mínimo 32 caracteres aleatorios
JWT_SECRET=CHANGE_ME_at_least_32_random_chars

# Opcional: clave de Google Places API (búsquedas en segundos y con web
# siempre). Si está vacía se usa el scraper Playwright como fallback.
GOOGLE_PLACES_API_KEY=
# Opcional: proxies para el scraper de Google Maps (fallback sin API), separados por coma.
# Se usa uno al azar por búsqueda. Ej: http://usuario:clave@host:puerto,http://host2:puerto
SCRAPER_PROXY_URLS=

# Claude API para el módulo de Diseño (flyers, posts, banners).
ANTHROPIC_API_KEY=

# Opcional: OAuth de Google para sincronizar las citas con Google Calendar.
# Cliente OAuth "Aplicación web" con redirect URI autorizada:
#   https://<CRM_DOMAIN>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: integración con Canva (sin uso por ahora).
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
FRONTEND_URL=https://crm.codeviaesp.com

# ─── CRM — Usuario admin inicial (idempotente al reiniciar) ──
SEED_ADMIN_EMAIL=admin@codevia.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ─── Córdoba Bets ─────────────────────────────
# Debe coincidir con el server_name literal en CORDOBA-BETS/frontend/nginx.conf.
CORDOBABETS_DOMAIN=cordobabets.codeviaesp.com
# Base propia dentro del PostgreSQL de arriba. La crea `make cb-init`.
CORDOBABETS_DB=cordobabets

# Secreto propio, distinto al del CRM: si se filtrase uno, no abre el otro.
# Generar con: openssl rand -base64 48
CORDOBABETS_JWT_SECRET=CHANGE_ME_at_least_32_random_chars

# Acceso al panel del tipster (/panel). Mínimo 12 caracteres.
CORDOBABETS_ADMIN_EMAIL=hugo@cordobabets.com
CORDOBABETS_ADMIN_PASSWORD=CHANGE_ME_strong_password
CORDOBABETS_ADMIN_NOMBRE=Hugo

# Bot de Telegram (opcional). El token se guarda sin que se vea con
# `bash poner-token-cb.sh`. CANAL = id del canal (-100…), AVISOS = chat
# privado del administrador: el bot solo obedece a ese chat.
# ⚠️ El bot usa long polling: NUNCA lo arranques en dos sitios con el mismo token.
CORDOBABETS_TELEGRAM_TOKEN=
CORDOBABETS_TELEGRAM_CANAL=
CORDOBABETS_TELEGRAM_AVISOS=

# ─── Breakpoint Tennis ────────────────────────
# Debe coincidir con el server_name literal en BREAKPOINT-TENNIS/frontend/nginx.conf.
BREAKPOINT_DOMAIN=breakpoint.codeviaesp.com
BREAKPOINT_DB=breakpoint
# Generar con: openssl rand -base64 48
BREAKPOINT_JWT_SECRET=CHANGE_ME_at_least_32_random_chars
BREAKPOINT_ADMIN_EMAIL=admin@breakpoint.local
BREAKPOINT_ADMIN_NOMBRE=Breakpoint
# La contraseña del panel NO va aquí: se pasa una sola vez al sembrar
# (ver BREAKPOINT-TENNIS/README.md → "Usuario del panel").
# Bot de Telegram opcional, mismo formato que el de Córdoba Bets.
BREAKPOINT_TELEGRAM_TOKEN=
BREAKPOINT_TELEGRAM_CANAL=
BREAKPOINT_TELEGRAM_AVISOS=
