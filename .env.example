# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Dominios
LANDING_DOMAIN=codeviaesp.com
CRM_DOMAIN=crm.codeviaesp.com

# Demos en vivo — deben coincidir con los server_name literales
# en CODEVIA-DEMOS/nginx.conf si los cambias.
DEMO_RESTAURANTE_DOMAIN=demo-restaurante.codeviaesp.com
DEMO_CLINICA_DOMAIN=demo-clinica.codeviaesp.com
DEMO_TIENDA_DOMAIN=demo-tienda.codeviaesp.com

# Portfolio personal — debe coincidir con el server_name literal
# en CODEVIA-PORTFOLIO-HUGO/nginx.conf si lo cambias.
PORTFOLIO_HUGO_DOMAIN=hugo.codeviaesp.com

# Córdoba Bets — debe coincidir con el server_name literal en
# CORDOBA-BETS/frontend/nginx.conf si lo cambias.
CORDOBABETS_DOMAIN=cordobabets.codeviaesp.com

# Email para Let's Encrypt (notificaciones de expiración)
LETSENCRYPT_EMAIL=codeviainfo@gmail.com

# ─── CRM — Base de datos ──────────────────────
POSTGRES_USER=codevia
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=codevia_crm

# ─── CRM — Backend ────────────────────────────
# JWT_SECRET: mínimo 32 caracteres aleatorios
JWT_SECRET=CHANGE_ME_at_least_32_random_chars

# Opcional: clave de Google Places API para scraping más fiable.
# Si está vacía se usa el scraper Playwright como fallback.
GOOGLE_PLACES_API_KEY=
# Opcional: proxies para el scraper de Google Maps (fallback sin API), separados por coma.
# Se usa uno al azar por búsqueda. Ej: http://usuario:clave@host:puerto,http://host2:puerto
SCRAPER_PROXY_URLS=

# ─── CRM — Usuario admin inicial (idempotente al reiniciar) ──
SEED_ADMIN_EMAIL=admin@codevia.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ─── Córdoba Bets ─────────────────────────────
# Usa la misma instancia de PostgreSQL que el CRM (POSTGRES_USER /
# POSTGRES_PASSWORD de arriba) pero con su propia base de datos, que hay que
# crear una sola vez:
#   docker exec -it codevia-crm-db psql -U codevia -c "CREATE DATABASE cordobabets;"
CORDOBABETS_DB=cordobabets

# Secreto propio, distinto al del CRM: si se filtrase uno, no abre el otro.
# Generar con: openssl rand -base64 48
CORDOBABETS_JWT_SECRET=CHANGE_ME_at_least_32_random_chars

# Acceso al panel del tipster (/panel). Mínimo 12 caracteres.
CORDOBABETS_ADMIN_EMAIL=hugo@cordobabets.com
CORDOBABETS_ADMIN_PASSWORD=CHANGE_ME_strong_password
CORDOBABETS_ADMIN_NOMBRE=Hugo

# ─── Auditoría de IA ──────────────────────────
# Panel y gateway. Deben coincidir con el server_name literal en
# CODEVIA-AUDITORIA-IA/frontend/nginx.conf y con el nombre del fichero
# vhost.d/<GATEWAY_DOMAIN>_location si los cambias.
AUDITORIA_DOMAIN=auditoria.codeviaesp.com
GATEWAY_DOMAIN=gw.codeviaesp.com

# Base propia dentro del PostgreSQL del CRM. La crea `make ia-init`.
AUDITORIA_DB=auditoria_ia

# Secreto propio, distinto al del CRM y al de Córdoba Bets: si se
# filtrase uno, no abre los otros. Generar con: openssl rand -base64 48
AUDITORIA_JWT_SECRET=CHANGE_ME_at_least_32_random_chars

# Secreto compartido api <-> gateway, para que la API pueda invalidar
# la caché de credenciales del gateway al revocar una clave. Sin esto,
# revocar tarda hasta 10 minutos en surtir efecto, y eso es un
# incidente de seguridad reportable. Generar con: openssl rand -base64 32
AUDITORIA_SECRETO_INTERNO=CHANGE_ME_at_least_32_random_chars

# Generaciones ANTERIORES de la clave maestra, solo durante una
# rotación, separadas por comas ("g1:base64,g0:base64"). Vacío en
# condiciones normales. La clave ACTUAL no va aquí: va en el fichero
# secretos/clave_maestra (ver el bloque `secrets:` del compose).
AUDITORIA_CLAVES_ANTIGUAS=

# Administrador inicial del panel. Mínimo 12 caracteres.
AUDITORIA_ADMIN_EMAIL=codeviainfo@gmail.com
AUDITORIA_ADMIN_PASSWORD=CHANGE_ME_strong_password
AUDITORIA_ADMIN_NOMBRE=Hugo
